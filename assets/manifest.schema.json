{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/coobytron/Cute/assets/manifest.schema.json",
  "title": "Cute Face Builder authored asset manifest",
  "type": "object",
  "required": ["schemaVersion", "canonicalCanvas", "assetTypes", "assets", "recipes"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "product": { "type": "string", "minLength": 1 },
    "sourceOfTruth": { "type": "string", "minLength": 1 },
    "canonicalCanvas": {
      "type": "object",
      "required": ["width", "height", "coordinateSystem"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "coordinateSystem": { "const": "top-left" }
      },
      "additionalProperties": false
    },
    "assetTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "recipes": {
      "type": "array",
      "items": { "$ref": "#/$defs/recipe" }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "required": ["x", "y", "scale", "rotation", "flipX"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "rotation": { "type": "number" },
        "flipX": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "required": ["left", "top", "right", "bottom"],
      "properties": {
        "left": { "type": "number" },
        "top": { "type": "number" },
        "right": { "type": "number" },
        "bottom": { "type": "number" }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "label",
        "type",
        "sourceFile",
        "thumbnail",
        "nativeCanvas",
        "anchor",
        "defaultTransform",
        "zOrder",
        "speciesTags",
        "compatibleAssetIds",
        "supportedPalettes",
        "exportBounds"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "sourceFile": { "type": "string", "minLength": 1 },
        "thumbnail": { "type": "string", "minLength": 1 },
        "nativeCanvas": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "anchor": { "$ref": "#/$defs/point" },
        "defaultTransform": { "$ref": "#/$defs/transform" },
        "zOrder": { "type": "integer", "minimum": 0, "maximum": 999 },
        "speciesTags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "compatibleAssetIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "supportedPalettes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "exportBounds": { "$ref": "#/$defs/bounds" },
        "reviewStatus": { "enum": ["sample", "draft", "review", "approved", "blocked"] }
      },
      "additionalProperties": true
    },
    "recipe": {
      "type": "object",
      "required": ["id", "label", "mode", "paletteId", "expressionId", "finishId", "backgroundId", "transform"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["complete-face", "parts"] },
        "completeFaceId": { "type": "string" },
        "partIds": { "type": "object", "additionalProperties": { "type": "string" } },
        "paletteId": { "type": "string" },
        "expressionId": { "type": "string" },
        "finishId": { "type": "string" },
        "backgroundId": { "type": "string" },
        "frameId": { "type": ["string", "null"] },
        "transform": {
          "type": "object",
          "required": ["scale", "rotation", "flipX"],
          "properties": {
            "scale": { "type": "number", "exclusiveMinimum": 0 },
            "rotation": { "type": "number" },
            "flipX": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "legacyId": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
